# AunXz Discord bot configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_application_id_here
# Optional: fast slash-command registration while testing in one server
GUILD_ID=
OWNER_IDS=123456789012345678
OWNER_ID=
OWNER_GUILD_ID=

# Private owner logs (optional)
OWNER_COMMAND_LOG_CHANNEL_ID=
OWNER_ERROR_LOG_CHANNEL_ID=
OWNER_ONLINE_LOG_CHANNEL_ID=
OWNER_JOIN_LOG_CHANNEL_ID=
OWNER_MAIN_CHANNEL_ID=
DISCORD_UPLOAD_LIMIT_BYTES=25165824

# Optional statistics-channel update intervals
STAT_SERVER_INTERVAL_MINUTES=7
STAT_SOCIAL_INTERVAL_MINUTES=12
MAX_STAT_CHANNELS_PER_GUILD=10

# AI-powered /templategen (template generation still works; API key is needed only for AI generation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_SITE_URL=https://github.com/anx6ty/AunXz
OPENROUTER_APP_NAME=AunXz Template Studio
# Keep this stable to preserve signatures for previously saved template codes
TEMPLATE_SECRET=replace-with-a-long-random-secret
