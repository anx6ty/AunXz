# Copy this file to .env when running locally.
# On Railway, set these as Variables in the project settings instead of using this file.

DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
# Optional: set to a guild ID to register commands instantly to one server while testing.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
GUILD_ID=
# Comma separated list of Discord user IDs who get owner-only commands.
OWNER_IDS=123456789012345678

# Stat voice-channel updater defaults (can also be changed per tracked channel)
STAT_SERVER_INTERVAL_MINUTES=7
STAT_SOCIAL_INTERVAL_MINUTES=12
MAX_STAT_CHANNELS_PER_GUILD=10

# Main owner (only this user can add/remove co-owners, restore, or reset guild data).
OWNER_ID=
# Guild where owner-only slash commands should be visible. Leave blank to disable owner slash registration.
OWNER_GUILD_ID=
# Private channels for owner command and error logs (never use a public channel).
OWNER_COMMAND_LOG_CHANNEL_ID=
OWNER_ERROR_LOG_CHANNEL_ID=
OWNER_ONLINE_LOG_CHANNEL_ID=
OWNER_JOIN_LOG_CHANNEL_ID=
OWNER_MAIN_CHANNEL_ID=
# Discord upload-limit override for database backups (bytes). Default is 24 MiB.
DISCORD_UPLOAD_LIMIT_BYTES=25165824

# ---- Template bridge / AI template generator (all optional) ----
# AI features need an OpenRouter key: create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Public address of the website (sent to OpenRouter as the referer).
SITE_URL=
# Secret used to sign template codes. If you already saved templates, set this to the value they were signed
# with (until now that was your DISCORD_TOKEN). Use the same value on the web app and the bot.
